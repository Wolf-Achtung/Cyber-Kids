# MongoDB Configuration
MONGO_URL=mongodb://localhost:27017
DB_NAME=cyberguard_kids

# CORS Configuration
# Comma-separated list of allowed origins, or use '*' for all (not recommended for production)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# OpenAI API Configuration (optional, but recommended for enhanced classification)
# You can get an API key from https://platform.openai.com/account/api-keys
EMERGENT_LLM_KEY=your_openai_api_key_here
# Alternative: OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model Selection
# Options: gpt-4, gpt-4-turbo, gpt-3.5-turbo, gpt-5 (if available)
OPENAI_MODEL=gpt-4

# Server Configuration (optional)
# HOST=0.0.0.0
# PORT=8000
